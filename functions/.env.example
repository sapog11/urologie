# Firebase Cloud Functions Configuration
# Copy this file to .env and fill in the actual values

# Gmail credentials for sending appointment emails
EMAIL_USER=jekazorich@gmail.com
EMAIL_PASSWORD=your_app_password_here

# Recipient email for appointment notifications
APPOINTMENT_RECIPIENT=jekazorich@gmail.com

# Note:
# - EMAIL_PASSWORD should be an App Password if you have 2FA enabled on your Gmail account
# - See: https://support.google.com/accounts/answer/185833
# - APPOINTMENT_RECIPIENT can be changed when you purchase the mencare.cz domain
